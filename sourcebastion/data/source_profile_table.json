{
  "version": "sourcebastion.source-profile-table/1",
  "note": "Extension and name matches are hints. A YAML or JSON path does not prove Kubernetes or CloudFormation content, so those stay candidates.",
  "languages": {
    "extensions": {
      ".c": "c", ".h": "c",
      ".cc": "cpp", ".cpp": "cpp", ".cxx": "cpp", ".hh": "cpp", ".hpp": "cpp", ".hxx": "cpp",
      ".cs": "csharp",
      ".go": "go",
      ".java": "java",
      ".kt": "kotlin", ".kts": "kotlin",
      ".scala": "scala",
      ".js": "javascript", ".mjs": "javascript", ".cjs": "javascript", ".jsx": "javascript",
      ".ts": "typescript", ".mts": "typescript", ".cts": "typescript", ".tsx": "typescript",
      ".py": "python", ".pyi": "python",
      ".rb": "ruby",
      ".php": "php",
      ".rs": "rust",
      ".swift": "swift",
      ".m": "objective-c", ".mm": "objective-c",
      ".dart": "dart",
      ".lua": "lua",
      ".pl": "perl", ".pm": "perl",
      ".r": "r",
      ".ex": "elixir", ".exs": "elixir",
      ".erl": "erlang",
      ".hs": "haskell",
      ".clj": "clojure",
      ".sh": "shell", ".bash": "shell", ".zsh": "shell",
      ".ps1": "powershell",
      ".sql": "sql",
      ".vue": "vue",
      ".svelte": "svelte",
      ".sol": "solidity"
    }
  },
  "infrastructure": {
    "names": {
      "Dockerfile": "dockerfile",
      "Containerfile": "dockerfile",
      "Chart.yaml": "helm",
      "docker-compose.yml": "compose",
      "docker-compose.yaml": "compose",
      "compose.yml": "compose",
      "compose.yaml": "compose"
    },
    "name_prefixes": {
      "Dockerfile.": "dockerfile"
    },
    "extensions": {
      ".tf": "terraform",
      ".tfvars": "terraform",
      ".bicep": "bicep",
      ".dockerfile": "dockerfile",
      ".yaml": "yaml-candidate",
      ".yml": "yaml-candidate"
    }
  },
  "manifests": {
    "patterns": {
      "requirements*.txt": "pip-requirements"
    }
  },
  "path_classes": {
    "order": ["vendored", "generated", "test", "docs"],
    "vendored": {
      "directories": ["vendor", "vendors", "node_modules", "third_party", "third-party", "thirdparty", "bower_components", "Pods"]
    },
    "generated": {
      "name_suffixes": [".pb.go", ".pb.cc", ".pb.h", "_pb2.py", "_pb2_grpc.py", ".min.js", ".min.css", ".generated.go", ".generated.ts", ".g.dart", ".freezed.dart"],
      "name_prefixes": ["zz_generated"],
      "directories": ["generated", "__generated__", "gen"]
    },
    "test": {
      "directories": ["test", "tests", "__tests__", "testdata", "testing", "spec", "fixtures", "e2e"],
      "name_suffixes": ["_test.go", "_test.py", "_test.rb", "_spec.rb", "Test.java", "Tests.java", "Test.kt", "Tests.cs"],
      "name_prefixes": ["test_"],
      "name_infixes": [".test.", ".spec."]
    },
    "docs": {
      "directories": ["docs", "doc", "documentation", "examples", "example", "samples", "sample", "curriculum"],
      "extensions": [".md", ".markdown", ".rst", ".adoc", ".ipynb"]
    }
  }
}
