{
  "name": "ez-appsec",
  "displayName": "SourceBastion Scan",
  "description": "Inline security vulnerability diagnostics powered by SourceBastion Scan",
  "version": "0.1.0",
  "publisher": "ez-appsec",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sourcebastion/sourcebastion-scanner.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Linters", "Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ez-appsec.scanWorkspace",
        "title": "SourceBastion Scan: Scan Workspace"
      },
      {
        "command": "ez-appsec.clearFindings",
        "title": "SourceBastion Scan: Clear Findings"
      }
    ],
    "configuration": {
      "title": "SourceBastion Scan",
      "properties": {
        "ez-appsec.scanOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Run SourceBastion Scan automatically when a file is saved"
        },
        "ez-appsec.scanOnSaveDelay": {
          "type": "number",
          "default": 2000,
          "minimum": 500,
          "description": "Debounce delay in milliseconds before triggering scan after save (prevents rapid repeated scans)"
        },
        "ez-appsec.dockerImage": {
          "type": "string",
          "default": "ghcr.io/sourcebastion/sourcebastion-scanner:latest",
          "description": "Docker image to use for scanning"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "test": "vitest run",
    "package": "vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.13.6",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.11.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "5.0.1"
  }
}
